IDI_ICON1 ICON "pdftoolkit.ico"

1 VERSIONINFO
 FILEVERSION @PDFWORD_VERSION_MAJOR@,@PDFWORD_VERSION_MINOR@,@PDFWORD_VERSION_PATCH@,0
 PRODUCTVERSION @PDFWORD_VERSION_MAJOR@,@PDFWORD_VERSION_MINOR@,@PDFWORD_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "wangtc"
            VALUE "FileDescription", "Pdf-Toolkit - PDF/Word converter and previewer"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "pdftoolkit"
            VALUE "LegalCopyright", "MIT; bundles MuPDF (AGPL-3.0 or Artifex commercial license)"
            VALUE "OriginalFilename", "pdftoolkit.exe"
            VALUE "ProductName", "Pdf-Toolkit"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
